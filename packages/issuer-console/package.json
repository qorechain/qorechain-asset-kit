{
  "name": "@qorechain/issuer-console",
  "version": "0.1.0",
  "private": true,
  "description": "Issuer console over the QoreChain asset-kit EVM adapters (CMTAT and ERC-3643 on the QoreChain EVM Engine testnet).",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-artifacts": "node scripts/sync-artifacts.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
