{
  "name": "@qorechain/asset-kit",
  "version": "0.1.0",
  "description": "Proposed QoreChain regulated-asset modules: generated types, a client that reports the required chain upgrade, and an in-memory MockChain.",
  "license": "Apache-2.0",
  "author": "QoreChain Association",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qorechain/qorechain-asset-kit.git",
    "directory": "clients/ts"
  },
  "homepage": "https://github.com/qorechain/qorechain-asset-kit/tree/main/clients/ts#readme",
  "bugs": {
    "url": "https://github.com/qorechain/qorechain-asset-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen": "scripts/gen.sh",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ts-proto": "2.15.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
